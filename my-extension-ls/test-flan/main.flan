| sum: Int -> Int -> Int = /a => /b => sum a b

-- This is a comment
| strFits: Str -> Int -> Bool = 
    /word: Str =>
        | length: Int = len word 
        \ /word => leq length word

| askForBeer: Int -> Str = /age =>
    if geq age 18
        then "Yes"
        else "No"

| askForBeerInfer = /age => if 12 then True else "No"

| modifyIntWith: (Int -> Int) -> Int -> Int = modifyIntWith

| second: (Int -> Int) -> [Int, Int] -> [Int, Int] = /f => /[a, b] => [a, f b]

| secondAlt: (Int -> Int) -> [Int, Int] -> [Int, Int] = /f => /pair: [Int, Int] => 
    | [a, b] = pair
    | pairCopy = pair
    \ [a, pairCopy]

\ 0